{
  "name": "sashimi-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone Sashimi viewer for RNA-seq: one HTML file that reads BAM/CRAM files in the browser and draws coverage, splice-junction arcs, reads, exon usage and a splicing cartoon. No server, no upload.",
  "keywords": [
    "rnaseq",
    "sashimi",
    "splicing",
    "bam",
    "cram",
    "bioinformatics",
    "visualization",
    "genomics",
    "browser"
  ],
  "license": "CC-BY-NC-4.0",
  "author": "Benjamin Cogne (CHU Nantes)",
  "repository": {
    "type": "git",
    "url": "https://github.com/benjamin-cogne/Sashimi-viewer.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc",
    "build": "tsc && vite build && node scripts/finish.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@gmod/bam": "^9.0.1",
    "@gmod/bgzf-filehandle": "^6.6.0",
    "@gmod/cram": "^14.0.0",
    "@gmod/indexedfasta": "^5.0.11",
    "generic-filehandle2": "^2.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
